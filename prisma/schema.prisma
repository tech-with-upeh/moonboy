generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommentStatus {
  APPROVED
  PENDING
  REJECTED
}

enum PostEventType {
  VIEW
  LIKE
  UNLIKE
  COMMENT
  READ_START
  READ_COMPLETE
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
}

model Post {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String
  content        String
  category       String
  cover          String?
  coverUrl       String?
  date           DateTime @default(now())
  readTime       Int      @default(1)
  authorName     String   @default("Moonboy")
  authorInitials String   @default("MB")
  favorite       Boolean  @default(false)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  likes          PostLike[]
  comments       Comment[]
  views          PostView[]
  events         PostEvent[]

  @@index([published, date])
  @@index([category, published])
}

model PostLike {
  id         String   @id @default(cuid())
  postId     String
  visitorId  String
  createdAt  DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, visitorId])
  @@index([postId, createdAt])
}

model Comment {
  id         String        @id @default(cuid())
  postId     String
  visitorId  String
  name       String
  body       String
  status     CommentStatus @default(APPROVED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  post       Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status, createdAt])
  @@index([visitorId, createdAt])
}

model PostView {
  id         String   @id @default(cuid())
  postId     String
  visitorId  String
  viewedAt   DateTime @default(now())
  referrer   String?
  country    String?
  device     String?
  browser    String?
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, viewedAt])
  @@index([postId, visitorId])
}

model PostEvent {
  id         String         @id @default(cuid())
  postId     String
  visitorId  String
  type       PostEventType
  createdAt  DateTime       @default(now())
  referrer   String?
  country    String?
  device     String?
  browser    String?
  post       Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, type, createdAt])
  @@index([postId, visitorId, createdAt])
}
