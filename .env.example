# PostgreSQL database
DATABASE_URL=postgresql://moonboy:moonboy_password@localhost:5432/moonboy?schema=public

# Initial admin account
# Used only to create/update the first admin with `npm run db:seed`.
# After that, login credentials are stored in PostgreSQL.
ADMIN_EMAIL=moonboy@example.com
ADMIN_PASSWORD=change-this-to-a-long-strong-password
ADMIN_NAME=Moonboy

# Session security
# Generate a long random value for production. Do not reuse this example.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
