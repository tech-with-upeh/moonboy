# PostgreSQL database
DATABASE_URL=postgresql://moonboy:moonboy_password@localhost:5432/moonboy?schema=public

# Initial admin account
ADMIN_EMAIL=moonboy@example.com
ADMIN_PASSWORD=change-this-to-a-long-strong-password
ADMIN_NAME=Moonboy

# Session security
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://moonboynewsletter.com

# Backblaze B2 S3-compatible storage
B2_KEY_ID=your-b2-key-id
B2_APP_KEY=your-b2-application-key
B2_BUCKET=your-b2-bucket-name
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Public B2 S3 origin used by the Cloudflare Worker
B2_PUBLIC_BASE_URL=https://your-bucket.s3.us-west-004.backblazeb2.com

# Cloudflare Worker/CDN hostname used for public images
# Example: cdn.moonboynewsletter.com
NEXT_PUBLIC_IMAGE_HOST=cdn.example.com
