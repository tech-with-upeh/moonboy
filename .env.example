# Admin authentication
# The only credentials allowed to access /admin.
ADMIN_EMAIL=moonboy@example.com
ADMIN_PASSWORD=change-this-to-a-long-strong-password

# Session security
# Generate a long random value for production. Do not reuse the example value.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Application URL
# Used later for canonical URLs, email links, and other absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (reserved for the upcoming PostgreSQL + Prisma integration)
# Replace with your actual PostgreSQL connection string.
DATABASE_URL=postgresql://moonboy:moonboy_password@localhost:5432/moonboy?schema=public
